# Supabase (Phase 1)
# Supabase 대시보드 → Settings → API 에서 복사
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Service role 키는 서버 라우트에서만 사용 (관리자 작업/웹훅용). 클라이언트 노출 금지.
# 결제 승인 후 entitlements 삽입에 필요(RLS 우회). Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# 토스페이먼츠 (결제) — 테스트 키
# 대시보드 없이도 토스 개발자센터 문서의 공개 테스트 키로 전체 플로우 동작.
#   문서 테스트 키: https://docs.tosspayments.com/reference/using-api/api-keys
#   (실 운영 전환 시 가맹점 실 키로 교체)
# 클라이언트 키(브라우저 노출 OK, test_ck_ 또는 test_gck_ 로 시작)
PUBLIC_TOSS_CLIENT_KEY=
# 시크릿 키(서버 전용, 절대 클라이언트 노출 금지, test_sk_ 또는 test_gsk_ 로 시작)
TOSS_SECRET_KEY=

# 강의자료 수확 에이전트 — LLM 연결 (선택)
# 비워두면 결정적 모드(런타임 LLM 0): 아는 어근으로만 추출/분해. 키 불필요.
# LLM을 연결하면 처음 보는 어근까지 LLM이 추출·분해. 연결부 = src/lib/server/lecture-extract.ts
#   1) LECTURE_LLM=claude 로 켜고  2) ANTHROPIC_API_KEY 채우면 활성화.
LECTURE_LLM=
# Anthropic API 키 (console.anthropic.com). LECTURE_LLM=claude 일 때만 사용. 서버 전용.
ANTHROPIC_API_KEY=
# 사용할 모델 (기본 claude-opus-4-8). 비용 절감 시 claude-sonnet-4-6 등으로 교체.
LECTURE_LLM_MODEL=

# Google Gemini (무료 LLM 옵션) — LECTURE_LLM=gemini 일 때 사용.
#   무료 키: https://aistudio.google.com → Get API key (카드 불필요)
#   기본 모델 gemini-2.0-flash. 데이터가 Google로 전송되니 민감자료 주의.
GEMINI_API_KEY=
